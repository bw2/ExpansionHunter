# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.cpp text
*.hh text

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary

# Have `git archive` (and so GitHub's archive/<sha>.tar.gz downloads) fill in the commit date and SHA,
# so builds from a tarball without .git still report a real version (see ehunter/CMakeLists.txt).
ehunter/GitArchiveVersion.txt export-subst
